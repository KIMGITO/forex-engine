# ── Market data provider configuration ────────────────────────────────────────
# Provider selector: "twelvedata" (real) | "mock" (deterministic, default for tests)
MARKET_DATA_PROVIDER=twelvedata

# Twelve Data API key (https://twelvedata.com) — create a free account to obtain
# a personal API key. NEVER commit real credentials.
MARKET_DATA_API_KEY=f29df2c3870b4945b3f914062c861cfe
MARKET_DATA_BASE_URL=https://api.twelvedata.com

# ── Live/real-data integration tests ───────────────────────────────────────────
# Set to true ONLY when valid credentials are configured. Without credentials,
# the gated integration tests are skipped and normal tests still pass.
RUN_LIVE_DATA_TESTS=false